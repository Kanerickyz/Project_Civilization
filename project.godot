; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="战术战棋"
config/version="0.1.51"
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/autochess/branding/game_icon.png"

[autoload]

GameSettings="*res://scripts/autoload/game_settings.gd"

[display]

; iPhone 14 Pro portrait logical ~393x852 (physical ~1179x2556, ~19.5:9).
; Desktop uses 2x window override; Web/mobile fill via stretch. Landscape still stretches via expand.
window/size/viewport_width=393
window/size/viewport_height=852
window/size/window_width_override=786
window/size/window_height_override=1704
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
